    <view name="gamelist">
        <image name="nesBackground">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./assets/nes-console-bg.jpg</path>
            <opacity>0.42</opacity>
            <zIndex>0</zIndex>
        </image>

        <text name="ps5nesBrand">
            <pos>0.08 0.075</pos>
